{
  "name": "comq",
  "version": "0.16.1",
  "description": "ComQ",
  "author": {
    "name": "Artem Gurtovoi",
    "url": "https://github.com/temich"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toa-io/comq.git"
  },
  "bugs": {
    "url": "https://github.com/toa-io/comq/issues"
  },
  "keywords": [
    "AMQP",
    "RabbitMQ"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "source/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "feat": "scripts/feat.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cucumber/cucumber": "^13.2.1",
    "@jest/fake-timers": "^30.5.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "expect": "^30.5.2",
    "fast-glob": "^3.3.3",
    "fuzzysort": "4.0.2",
    "husky": "^9.1.7",
    "jest-mock": "^30.5.2",
    "js-yaml": "^5.4.1",
    "randomstring": "^1.3.1",
    "semantic-release": "^25.0.9",
    "snazzy": "^9.0.0",
    "standard": "^17.1.2",
    "testcontainers": "^12.0.4"
  },
  "dependencies": {
    "@toa.io/amqplib": "^0.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "test": "standard && node --test --experimental-test-module-mocks --import ./test/globals.js 'test/**/*.test.js' 'source/**/*.test.js'",
    "features": "cucumber-js --fail-fast -t 'not @manual'",
    "features:fast": "cucumber-js --fail-fast -t 'not @manual and not @heavy'",
    "benchmark": "node benchmarks/run.js",
    "lint": "standard --fix --verbose | snazzy"
  },
  "standard": {
    "globals": [
      "afterAll",
      "afterEach",
      "beforeAll",
      "beforeEach",
      "describe",
      "expect",
      "it",
      "jest",
      "test"
    ]
  },
  "overrides": {
    "rimraf": "^6.1.3",
    "archiver-utils": {
      "glob": "^13.0.6"
    }
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "cpu-features": false,
    "protobufjs": false,
    "ssh2": false,
    "unrs-resolver": false
  }
}
